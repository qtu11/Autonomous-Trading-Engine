# =======================================================================
# GOLDQUANT AI BLOOMBERG TRADING DESK - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your confidential local secrets.
# NEVER commit real credentials or secret tokens to Git!
# =======================================================================

# ── ADMIN ACCESS & SYSTEM SECURITY ──
ADMIN_LOGIN=
ADMIN_PASSWORD=
QUANTAI_BRIDGE_TOKEN=
QUANTAI_OPERATOR_TOKEN=

# ── METATRADER 5 (MT5) BROKER CREDENTIALS ──
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TERMINAL_TIMEOUT_SECONDS=30
MT5_AUTOSTART=true

# ── TELEGRAM NOTIFICATION BOT ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ── QUANT TRADING & RISK GATE CONFIG ──
QUANTAI_EXECUTION_MODE=DEMO
QUANTAI_ENABLE_TRADING=true
QUANTAI_DEMO_ARMED=true
QUANTAI_LIVE_ARMED=false
QUANTAI_KILL_SWITCH=false
QUANTAI_EXECUTION_SYMBOL=XAUUSDm
QUANTAI_EXECUTION_MAGIC=888999
QUANTAI_MAGIC_NUMBER=888999
QUANTAI_DEMO_LOGIN=
QUANTAI_DEMO_SERVER=
QUANTAI_DEMO_BROKER_COMPANY=
QUANTAI_DEMO_COMMAND_TTL_SECONDS=10

# ── AI ENGINE & MULTI-MODEL API KEYS ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

ZPLAY_API_KEY=
ZPLAY_BASE_URL=https://router.flatkey.ai/v1

QUANTAI_AI_MODEL=kimi-k3

# ── NETWORK & NEXT.JS WEB DASHBOARD ──
ATE_DASHBOARD_PORT=8005
ATE_DASHBOARD_HOST=0.0.0.0
QUANTAI_DASHBOARD_PORT=8005
QUANTAI_DASHBOARD_HOST=0.0.0.0
# CRITICAL: ATE_BACKEND_URL là nơi Next.js (Vercel/cloudlocal nginx) trỏ tới backend.
# - Chạy local:  http://127.0.0.1:8005
# - Deploy Vercel: phải set = http://<PUBLIC_IP>:80 (cloudlocal nginx) hoặc DDNS.
# KHÔNG trỏ về chính domain vercel.app (vòng lặp vô hạn -> lỗi "Không thể kết nối
# API Backend (port 8005)") và KHÔNG chứa hậu tố /api/v1 (double-prefix).
ATE_BACKEND_URL=http://127.0.0.1:8005
# Giao thức chuẩn (Standard URLs):
#   Website : https://autonomous-trading-engine.vercel.app/
#   Backend : https://autonomous-trading-engine.vercel.app/backend
#   API/v1  : https://autonomous-trading-engine.vercel.app/api/v1  (MT5 EA + website)
# NEXT_PUBLIC_* là ORIGIN (không hậu tố /api/v1) - frontend tự nối /api/... phía sau.
# Để TRỐNG trên Vercel để browser dùng same-origin /api/* và Next.js rewrite server-side.
NEXT_PUBLIC_ATE_API_ORIGIN=
NEXT_PUBLIC_QUANTAI_API_ORIGIN=
ATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app
QUANTAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app

# ── FIREBASE WEB APP CONFIGURATION ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=