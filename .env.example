# ═══════════════════════════════════════════════════════════════════════════
# AUTONOMOUS TRADING ENGINE (ATE) — ENVIRONMENT TEMPLATE (.env.example)
# ---------------------------------------------------------------------------
# Copy sang .env và điền giá trị thật. KHÔNG BAO GIỜ commit secret/token thật!
# Nguồn chuẩn mọi biến: ENVIRONMENT_CONFIG.md (root) / docs/ENVIRONMENT_CONFIG.md
# ═══════════════════════════════════════════════════════════════════════════

# ── ADMIN ACCESS & SYSTEM SECURITY ──
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Token xác thực EA <-> backend. TÊN CHUẨN code đọc: QUANTAI_BRIDGE_TOKEN
# (web proxy + python-bridge). ATE_BRIDGE_TOKEN = alias tương thích (cùng giá trị).
QUANTAI_BRIDGE_TOKEN=
ATE_BRIDGE_TOKEN=
ATE_OPERATOR_TOKEN=
# JWT cho web/auth — tạo bằng: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── EXECUTION MODE & RISK GATE (backend server.py) ──
# DEMO = server giả lập fill/close; LIVE = fail-closed, mọi lệnh qua EA thật.
ATE_EXECUTION_MODE=DEMO
ATE_ENABLE_TRADING=false
ATE_DEMO_ARMED=true
ATE_LIVE_ARMED=false
ATE_KILL_SWITCH=false
ATE_EXECUTION_SYMBOL=XAUUSDm
ATE_EXECUTION_MAGIC=888999
ATE_MAGIC_NUMBER=888999
ATE_RISK_PERCENT=1
ATE_MAX_POSITIONS=5
ATE_MAX_SPREAD=4.5
ATE_DEMO_COMMAND_TTL_SECONDS=10

# ── NETWORK & URL ──
# VNPT_PUBLIC_IP: IP công khai home server — đổi khi IP đổi.
VNPT_PUBLIC_IP=113.173.192.226
# CRITICAL: ATE_BACKEND_URL là nơi Next.js trỏ tới backend.
#  - Local  : http://127.0.0.1:8005
#  - Docker : http://backend:8005
#  - Vercel : http://<VNPT_PUBLIC_IP>:8848
# KHÔNG trỏ về domain vercel.app (vòng lặp) và KHÔNG chứa hậu tố /api/v1.
ATE_BACKEND_URL=http://127.0.0.1:8005
ATE_FRONTEND_URL=https://autonomous-trading-engine.vercel.app
ATE_MT5_API=https://autonomous-trading-engine.vercel.app/api/v1
# NEXT_PUBLIC_* là ORIGIN (không hậu tố /api/v1) — frontend tự nối /api/...
NEXT_PUBLIC_ATE_API_ORIGIN=
ATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app
ATE_DASHBOARD_HOST=0.0.0.0
ATE_DASHBOARD_PORT=8005
ATE_LOG_DIR=logs
DEBUG=false

# ── SERVICE URLS (backend) ──
BRIDGE_URL=http://localhost:8007
BRIDGE_PORT=8007
AI_ENGINE_URL=http://localhost:8006
AI_ENGINE_PORT=8006
FASTAPI_URL=http://localhost:8005   # python-bridge gọi backend
REDIS_HOST=localhost
REDIS_PORT=6379
# IP công khai home server (python-bridge dùng để dựng URL hiển thị)
PUBLIC_IP=

# ── AI ENGINE & MULTI-MODEL API KEYS ──
# Mặc định FREE trên OpenCode Zen (không cần key).
# ATE_AI_MODEL (backend) và QUANTAI_AI_MODEL (ai-engine) — alias cùng giá trị.
ATE_AI_MODEL=deepseek-v4-flash-free
QUANTAI_AI_MODEL=deepseek-v4-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
# Freebuff2API (OpenAI-compatible proxy → codebuff.com), token từ manicode.
FREEBUFF_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
FREEBUFF_AUTH_TOKEN=
# Key thương mại (tùy chọn — failover tự động)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ZPLAY_API_KEY=
ZPLAY_BASE_URL=https://router.flatkey.ai/v1
# Gateway router cá nhân (ưu tiên cao nhất khi cấu hình):
GATEWAY_URL=
GATEWAY_KEY=

# ── METATRADER 5 (bridge, chạy native Windows) ──
# EA MQL5 tự đăng nhập & báo cáo account — KHÔNG cần login/password/server.
MT5_PATH=
MT5_TERMINAL_TIMEOUT_SECONDS=30
MT5_AUTOSTART=false

# ── TELEGRAM NOTIFICATION BOT ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ── FIREBASE WEB APP (frontend) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── FIREBASE CLOUD SYNC (backend mirror config, tùy chọn) ──
FIREBASE_ENABLE_SYNC=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# base64 của serviceAccountKey.json (khuyến nghị khi bật sync):
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── POSTGRES (Docker Cloudlocal, tùy chọn) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ate
POSTGRES_USER=ate
POSTGRES_PASSWORD=
