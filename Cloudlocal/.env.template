# ═══════════════════════════════════════════════════════════════════════════
# AUTONOMOUS TRADING ENGINE (ATE) — CLOUDLOCAL ENV TEMPLATE (.env.template)
# Template file — COPY TO .env AND FILL IN YOUR ACTUAL VALUES
# Nguồn chuẩn mọi biến: ENVIRONMENT_CONFIG.md (root).
# ═══════════════════════════════════════════════════════════════════════════

# ── ADMIN ACCESS & SYSTEM SECURITY ──
ADMIN_LOGIN=your-email@example.com
ADMIN_PASSWORD=your-secure-password
# Tên chuẩn code đọc: QUANTAI_BRIDGE_TOKEN; ATE_BRIDGE_TOKEN = alias tương thích.
QUANTAI_BRIDGE_TOKEN=your-bridge-token
ATE_BRIDGE_TOKEN=
ATE_OPERATOR_TOKEN=
# JWT cho web/auth — tạo bằng: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── METATRADER 5 (MT5) LOCAL INSTALL (python-bridge, chạy native Windows) ──
# Không cần login/password/server: EA MQL5 tự báo cáo account lên backend.
MT5_PATH=C:\Program Files\MetaTrader 5-1\
MT5_TERMINAL_TIMEOUT_SECONDS=30
MT5_AUTOSTART=false

# ── TELEGRAM NOTIFICATION BOT ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_ENABLED=true

# ── EXECUTION MODE & RISK GATE ──
ATE_EXECUTION_MODE=DEMO          # DEMO / LIVE / DISABLED
ATE_ENABLE_TRADING=false
ATE_DEMO_ARMED=true
ATE_LIVE_ARMED=false
ATE_KILL_SWITCH=true
ATE_EXECUTION_SYMBOL=XAUUSDm
ATE_EXECUTION_MAGIC=888999
ATE_MAGIC_NUMBER=888999
ATE_RISK_PERCENT=1
ATE_MAX_POSITIONS=5
ATE_MAX_SPREAD=4.5
ATE_DEMO_COMMAND_TTL_SECONDS=10
ATE_LOG_DIR=/app/logs

# ── AI ENGINE & MULTI-MODEL API KEYS ──
# Mặc định FREE trên OpenCode Zen (không cần key).
# ATE_AI_MODEL (backend) và QUANTAI_AI_MODEL (ai-engine) — alias cùng giá trị.
ATE_AI_MODEL=deepseek-v4-flash-free
QUANTAI_AI_MODEL=deepseek-v4-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
# Key thương mại (tùy chọn — failover tự động)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ZPLAY_API_KEY=your-zplay-api-key
ZPLAY_BASE_URL=https://router.flatkey.ai/v1
# Gateway router cá nhân (ưu tiên cao nhất khi cấu hình):
GATEWAY_URL=
GATEWAY_KEY=

# ── FREEBUFF LLM GATEWAY (freebuff2api → codebuff.com) ──
# AuthToken Freebuff (từ ~/.config/manicode/credentials.json) để copilot gọi
# model deepseek qua proxy OpenAI-compatible (port 8080).
FREEBUFF_AUTH_TOKEN=your-freebuff-auth-token
FREEBUFF_LLM_URL=http://freebuff2api:8080/v1/chat/completions

# ── NETWORK & NEXT.JS WEB DASHBOARD ──
ATE_DASHBOARD_PORT=8005
ATE_DASHBOARD_HOST=0.0.0.0
BRIDGE_PORT=8007
# Service URLs (Cloudlocal dùng tên service Docker):
BRIDGE_URL=http://python-bridge:8007
AI_ENGINE_URL=http://ai-engine:8006
AI_ENGINE_PORT=8006
FASTAPI_URL=http://fastapi:8005
REDIS_HOST=redis
REDIS_PORT=6379
DEBUG=false
# IP công khai home server (python-bridge dùng để dựng URL hiển thị):
PUBLIC_IP=YOUR_PUBLIC_IP
# ATE_BACKEND_URL: backend FastAPI. Cloudlocal: http://nginx:80 (rewrite).
# Local: http://127.0.0.1:8005. KHÔNG trỏ vercel.app và KHÔNG chứa /api/v1.
ATE_BACKEND_URL=http://nginx:80
ATE_FRONTEND_URL=https://autonomous-trading-engine.vercel.app
ATE_MT5_API=https://autonomous-trading-engine.vercel.app/api/v1
NEXT_PUBLIC_ATE_API_ORIGIN=
ATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app

# ── FIREBASE WEB APP CONFIGURATION ──
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ── FIREBASE CLOUD SYNC ──
FIREBASE_ENABLE_SYNC=false
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-api-key
# base64 của serviceAccountKey.json (khuyến nghị khi bật sync):
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── POSTGRES (Docker) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ate
POSTGRES_USER=ate
POSTGRES_PASSWORD=your-postgres-password
