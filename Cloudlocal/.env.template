# ── ADMIN ACCESS & SYSTEM SECURITY ──
ADMIN_LOGIN=your-email@example.com
ADMIN_PASSWORD=your-secure-password
QUANTAI_BRIDGE_TOKEN=your-bridge-token
QUANTAI_OPERATOR_TOKEN=

# ── METATRADER 5 (MT5) LOCAL INSTALL (optional, python-bridge only) ──
