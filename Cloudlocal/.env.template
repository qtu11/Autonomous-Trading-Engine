MT5_PATH=C:\Program Files\MetaTrader 5-1\
MT5_TERMINAL_TIMEOUT_SECONDS=30
MT5_AUTOSTART=false

# ── TELEGRAM NOTIFICATION BOT ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
