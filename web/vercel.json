{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "env": {
    "ATE_FRONTEND_URL": "https://autonomous-trading-engine.vercel.app",
    "NEXT_PUBLIC_ATE_API_ORIGIN": "https://autonomous-trading-engine.vercel.app",
    "ATE_BACKEND_URL": "@ATE_BACKEND_URL",
    "ATE_BRIDGE_TOKEN": "@ATE_BRIDGE_TOKEN",
    "QUANTAI_BRIDGE_TOKEN": "@QUANTAI_BRIDGE_TOKEN",
    "MT5_BRIDGE_TOKEN": "@MT5_BRIDGE_TOKEN",
    "ADMIN_LOGIN": "@ADMIN_LOGIN",
    "ADMIN_PASSWORD": "@ADMIN_PASSWORD",
    "JWT_SECRET": "@JWT_SECRET",
    "JWT_REFRESH_SECRET": "@JWT_REFRESH_SECRET",
    "ATE_EXECUTION_MODE": "@ATE_EXECUTION_MODE",
    "ATE_LIVE_ARMED": "@ATE_LIVE_ARMED",
    "ATE_DEMO_ARMED": "@ATE_DEMO_ARMED",
    "VERCEL": "1",
    "VERCEL_ENV": "production"
  }
}
