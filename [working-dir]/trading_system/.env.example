# Environment Configuration
# Copy this file to .env and fill in your API keys

# App Settings
APP_NAME=Qtus Trading System
VERSION=2.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Trading Mode: paper, live, backtest
TRADING_MODE=paper
SELECTED_BROKER=binance

# Broker API Keys (for live trading)
# BINANCE
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Risk Management
MAX_RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=3.0
MAX_CONSECUTIVE_LOSSES=3
MAX_OPEN_TRADES=2

# Trading Parameters
DEFAULT_TIMEFRAME=1h
SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT"]

# SMC Settings
SWING_LOOKBACK=20
FVG_LOOKBACK=3

# ICT Settings
LONDON_KZ_START=08:00
LONDON_KZ_END=09:00
NY_KZ_START=13:30
NY_KZ_END=14:30

# Signal Thresholds
ADX_STRONG_THRESHOLD=25.0
SCORE_MIN_STRONG=8
SCORE_MIN_VALID=6

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
