# =====================================================================
# ATE Backend — environment variables for VPS deployment
# Copy this to .env and fill in your secrets.
#   cp .env.example .env
#   nano .env
# =====================================================================

# -------------------- Core --------------------
# ATE_EXECUTION_MODE chỉ là FALLBACK khi EA CHƯA kết nối.
# Khi MT5 EA gửi telemetry với account_mode="REAL" → backend tự động set LIVE.
#                                  account_mode="DEMO" → backend tự động set DEMO.
# → Chỉ cần copy .ex5 vào MT5 là đủ, KHÔNG cần đổi env mỗi lần đổi account.
# ATE_EXECUTION_MODE=DEMO   # default fallback khi EA chưa connect
ATE_EXECUTION_MODE=DEMO
QUANTAI_EXECUTION_MODE=DEMO
QUANTAI_ENABLE_TRADING=false
QUANTAI_DEMO_ARMED=true
QUANTAI_LIVE_ARMED=false
QUANTAI_KILL_SWITCH=true

# Demo live-fill injection (defaults are fine)
QUANTAI_DEMO_COMMAND_TTL_SECONDS=10

# -------------------- Bridge / MT5 --------------------
# Bearer token that MT5 EA uses on every push.
# Must match:   MT5 EA input "InpBridgeToken"
# Đổi sang token riêng của bạn — KHÔNG dùng giá trị mặc định trong production!
QUANTAI_BRIDGE_TOKEN=change-me-bridge-token
QUANTAI_OPERATOR_TOKEN=change-me-bridge-token

# Symbol the EA trades (with broker suffix)
QUANTAI_EXECUTION_SYMBOL=XAUUSDm
# Magic number — set the same in EA "InpMagicNumber"
QUANTAI_EXECUTION_MAGIC=888999
QUANTAI_MAGIC_NUMBER=888999

# -------------------- Admin login --------------------
# BẮT BUỘC đổi — login fail-closed từ ADMIN_LOGIN/ADMIN_PASSWORD env.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please

# -------------------- AI Providers --------------------
# Free public OpenCode Zen pool (default — no key required)
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
QUANTAI_AI_MODEL=deepseek-v4-flash-free

# Optional paid providers — fill only if you have keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ZPLAY_API_KEY=
GATEWAY_URL=
GATEWAY_KEY=

# -------------------- Telegram --------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------- Frontend CORS --------------------
# (Already set in compose; here for transparency)
ATE_ALLOWED_ORIGINS=https://autonomous-trading-engine.vercel.app,https://*.vercel.app
QUANTAI_ALLOWED_ORIGINS=https://autonomous-trading-engine.vercel.app,https://*.vercel.app

# -------------------- News protection --------------------
# true = when calendar data missing, treat as "unknown" and block entries
ATE_NEWS_PROTECTION_DEV_MODE=true
