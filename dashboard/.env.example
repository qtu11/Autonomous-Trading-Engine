# =============================================
# CANONICAL URL STRUCTURE (Vercel Deployment)
# =============================================
#   Website : https://autonomous-trading-engine.vercel.app/
#   Backend : https://autonomous-trading-engine.vercel.app/backend
#   API/v1  : https://autonomous-trading-engine.vercel.app/api/v1

ATE_FRONTEND_URL=https://autonomous-trading-engine.vercel.app
ATE_BACKEND_URL=https://autonomous-trading-engine.vercel.app/backend
ATE_MT5_API=https://autonomous-trading-engine.vercel.app/api/v1

# =============================================
# DASHBOARD BACKEND CONFIGURATION
# =============================================



# Server
ATE_DASHBOARD_HOST=192.168.1.12
ATE_DASHBOARD_PORT=8848

# MT5
MT5_AUTOSTART=true
MT5_PATH=C:\Program Files\MetaTrader 5-1\
MT5_TERMINAL_TIMEOUT_SECONDS=30

# CORS - Allow Vercel domain
ATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app

# Trading
ATE_EXECUTION_MODE=LIVE
ATE_EXECUTION_SYMBOL=XAUUSDm
ATE_DEMO_ARMED=true
ATE_LIVE_ARMED=true
ATE_ENABLE_TRADING=true
ATE_EXECUTION_MAGIC=888999
ATE_BRIDGE_TOKEN=20022007@Tu
ATE_KILL_SWITCH=false
ATE_OPERATOR_TOKEN=
ATE_DEMO_COMMAND_TTL_SECONDS=10

# Admin
ADMIN_LOGIN=qtusdev@quanttrading.ai
ADMIN_PASSWORD=qtusdev07

# AI Providers
GEMINI_API_KEY=your_gemini_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your_openai_key
