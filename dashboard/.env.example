# ═══════════════════════════════════════════════════════════════════════════
# TRADEAI ATE — DASHBOARD BACKEND TEMPLATE (.env.example)  [COMMIT AN TOÀN]
# Copy sang .env khi chạy `python server.py` trong thư mục dashboard/.
# Nguồn chuẩn: ENVIRONMENT_CONFIG.md (root). KHÔNG commit secret thật.
# ═══════════════════════════════════════════════════════════════════════════

# ── SERVICE URLS ──
BRIDGE_URL=http://localhost:8007      # python-bridge (MT5, native Windows)
BRIDGE_PORT=8007
AI_ENGINE_URL=http://localhost:8006   # AI Engine (Docker tùy chọn)
AI_ENGINE_PORT=8006
FASTAPI_URL=http://localhost:8005   # python-bridge gọi backend
REDIS_HOST=localhost
REDIS_PORT=6379
# IP công khai home server (python-bridge dùng để dựng URL hiển thị):
PUBLIC_IP=

# ── MT5 (bridge chạy cùng máy — EA MQL5 tự đăng nhập & báo cáo account) ──
# KHÔNG cần MT5_LOGIN/PASSWORD/SERVER ở đây.
MT5_PATH=
MT5_AUTOSTART=false
MT5_TERMINAL_TIMEOUT_SECONDS=30

# ── WEB-ONLY VARS (đặt ở web/.env — KHÔNG cần ở backend, liệt kê để tham chiếu) ──
# ATE_BACKEND_URL, ATE_FRONTEND_URL, ATE_MT5_API, JWT_SECRET, JWT_REFRESH_SECRET,
# NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_ATE_API_ORIGIN

# ── SERVER BIND (backend LUÔN dùng 8005 — 8848 là cổng public nginx) ──
ATE_DASHBOARD_HOST=0.0.0.0
ATE_DASHBOARD_PORT=8005
ATE_LOG_DIR=logs
DEBUG=false

# ── ADMIN AUTH ──
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ── EXECUTION & RISK ──
# phải khớp InpBridgeToken trong EA:
QUANTAI_BRIDGE_TOKEN=
ATE_BRIDGE_TOKEN=
ATE_EXECUTION_MODE=DEMO          # DEMO / LIVE / DISABLED
ATE_ENABLE_TRADING=false
ATE_DEMO_ARMED=true
ATE_LIVE_ARMED=false
ATE_KILL_SWITCH=false
ATE_EXECUTION_SYMBOL=XAUUSDm
ATE_EXECUTION_MAGIC=888999
ATE_MAGIC_NUMBER=888999
ATE_RISK_PERCENT=1
ATE_MAX_POSITIONS=5
ATE_MAX_SPREAD=4.5
ATE_DEMO_COMMAND_TTL_SECONDS=10

# ── AI / LLM ──
# ATE_AI_MODEL (backend) và QUANTAI_AI_MODEL (ai-engine) — alias cùng giá trị.
ATE_AI_MODEL=deepseek-v4-flash-free
QUANTAI_AI_MODEL=deepseek-v4-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
FREEBUFF_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
FREEBUFF_AUTH_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ZPLAY_API_KEY=
ZPLAY_BASE_URL=https://router.flatkey.ai/v1
GATEWAY_URL=
GATEWAY_KEY=

# ── TELEGRAM ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ── FIREBASE CLOUD SYNC (tùy chọn) ──
FIREBASE_ENABLE_SYNC=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# base64 của serviceAccountKey.json (khuyến nghị khi bật sync):
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── CORS ──
ATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autonomous-trading-engine.vercel.app
